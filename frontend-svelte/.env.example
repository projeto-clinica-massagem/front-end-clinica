# Mantém o frontend independente do backend durante os testes no GitHub Pages.
VITE_MOCK_API=true

# Use somente quando quiser testar a API FastAPI real.
VITE_API_URL=http://127.0.0.1:8001/api
VITE_DEV_API_TARGET=http://127.0.0.1:8001

# Para testar o Django real localmente via proxy Vite:
# VITE_MOCK_API=false
# VITE_API_URL=/api
# VITE_DEV_API_TARGET=https://resident-ride-gender-portsmouth.trycloudflare.com
